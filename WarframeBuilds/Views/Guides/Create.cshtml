@model Guide
@{ViewData["Title"]="Поделись своими знаниями.";}<section class="page-heading"><span class="eyebrow">ГАЙДЫ СООБЩЕСТВА</span><h1>Поделись своими знаниями.</h1></section><form action="/Guides/Create" method="post" class="panel build-form">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation"></div><input type="hidden" asp-for="Id"/><label>Название<input asp-for="Title" required maxlength="150"/></label><label>Краткое описание<textarea asp-for="Description" required maxlength="1000" rows="3"></textarea></label><label>Категория<input asp-for="Category" required maxlength="60"/></label><label>Текст гайда<textarea asp-for="Content" required maxlength="40000" rows="18"></textarea></label><p class="muted">Текст публикуется как обычный текст. Используй абзацы для удобства чтения.</p><button class="button primary">Сохранить гайд</button></form>