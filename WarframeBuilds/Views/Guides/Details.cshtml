@model Guide
@{ViewData["Title"]=Model.Title;var owner=Model.UserId==User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value && User.Identity?.IsAuthenticated==true;}<article class="reading"><a class="eyebrow" href="/Guides">← ВСЕ ГАЙДЫ</a><section class="page-heading"><span class="tag">@Model.Category</span><h1>@Model.Title</h1><p>@Model.Description</p><div class="muted">@Model.Author · @Model.ReadTime</div></section><div class="panel preline guide-content">@Model.Content</div>@if(owner){<div class="actions"><a class="button" href="/Guides/Edit/@Model.Id">Редактировать</a><form action="/Guides/Delete/@Model.Id" method="post" data-confirm="Удалить гайд?">@Html.AntiForgeryToken()<button class="button danger">Удалить</button></form></div>}</article>