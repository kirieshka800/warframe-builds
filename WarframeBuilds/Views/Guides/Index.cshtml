@model IEnumerable<Guide>
@{ViewData["Title"]="Гайды";}<section class="page-heading heading-row"><div><span class="eyebrow">ЗНАНИЯ СООБЩЕСТВА</span><h1>Стань сильнее с каждым вылетом.</h1><p>Механики, тактики и находки других Тэнно.</p></div>@if(User.Identity?.IsAuthenticated==true){<a class="button primary" href="/Guides/Create">Написать гайд ↗</a>}</section><div class="card-grid">@foreach(var x in Model){<a class="build-card guide-card" href="/Guides/Details/@x.Id"><span class="tag">@x.Category</span><div class="build-glyph">≡</div><h2>@x.Title</h2><p>@x.Description</p><div class="card-bottom"><span>@x.Author</span><span>@x.ReadTime →</span></div></a>}</div>@if(!Model.Any()){<div class="empty"><h2>Здесь начинается база знаний</h2><p>Поделись первым гайдом с сообществом.</p></div>}