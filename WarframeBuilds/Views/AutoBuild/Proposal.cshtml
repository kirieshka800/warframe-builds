@model AutoBuildPreviewViewModel
@{ViewData["Title"]="Предложение сборки";var b=Model.Plan.Build;var s=Model.Stats;var hasMods=b.BuildMods.Any(x=>x.ModId.HasValue);}
<section class="page-heading"><span class="eyebrow">АВТОПОДБОР / ПРЕДПРОСМОТР</span><h1>@b.Title</h1><p>Проверь моды, ранги и полярности. Этот билд ещё не создан.</p><a class="button subtle" href="/AutoBuild?@(b.IsWeapon?"weaponId":"warframeId")=@(b.WeaponId??b.WarframeId)">Изменить условия</a></section>
<section class="panel auto-overview"><div><span class="eyebrow">ЦЕЛЬ</span><h2>@Model.Plan.GoalLabel</h2><p>@b.TargetName · @(b.HasReactor?"С реактором / катализатором":"Без реактора / катализатора")</p></div><div class="capacity"><span>Вместимость</span><strong>@s.UsedCapacity <small>/ @s.Capacity</small></strong><p>Форм потребуется: @b.FormasCount</p></div></section>
<section class="panel auto-explanation"><h2>Почему такие моды?</h2><ul>@foreach(var note in Model.Plan.Notes){<li>@note</li>}</ul></section>
<section class="auto-table-wrap"><table class="auto-table" data-testid="auto-preview-slots"><thead><tr><th>Слот</th><th>Мод</th><th>Ранг</th><th>Полярность</th><th>Стоимость</th><th>Зачем</th></tr></thead><tbody>
@foreach(var slot in b.BuildMods.OrderBy(x=>x.SlotIndex)){if(slot.Mod==null){continue;}<tr><td>@(slot.SlotIndex==8?(b.IsWeapon?"Стойка":"Аура"):slot.SlotIndex==9?"Эксилус":$"{slot.SlotIndex+1}")</td><td>@slot.Mod.Name</td><td>@slot.CurrentRank / @slot.Mod.MaxRank</td><td>@slot.SlotPolarity</td><td>@(slot.SlotIndex==8?"+":"")@BuildCalculator.ModCost(slot.Mod,slot.CurrentRank,slot.SlotPolarity,slot.SlotIndex==8)</td><td>@Model.Plan.Reasons.GetValueOrDefault(slot.SlotIndex,"Совместимый мод для выбранной цели.")</td></tr>}
</tbody></table></section>
@if(!hasMods){<div class="notice error">Для этого предмета не нашлось совместимых модов из правил подбора. Обнови каталог или создай билд вручную. Пустой билд не будет сохранён.</div>}
<section class="panel auto-result"><h2>Базовые характеристики</h2><dl class="stat-list">
@if(!b.IsWeapon){<dt>Здоровье</dt><dd>@s.Health.ToString("0.#")</dd><dt>Щиты</dt><dd>@s.Shields.ToString("0.#")</dd><dt>Броня</dt><dd>@s.Armor.ToString("0.#")</dd><dt>Энергия</dt><dd>@s.Energy.ToString("0.#")</dd><dt>Сила</dt><dd>@s.AbilityStrength.ToString("0.#")%</dd><dt>Длительность</dt><dd>@s.AbilityDuration.ToString("0.#")%</dd><dt>Радиус</dt><dd>@s.AbilityRange.ToString("0.#")%</dd><dt>Эффективность</dt><dd>@s.AbilityEfficiency.ToString("0.#")%</dd>}
else{<dt>Урон за попадание</dt><dd>@s.Damage.ToString("0.##")</dd><dt>Критический шанс</dt><dd>@((s.CriticalChance*100).ToString("0.#"))%</dd><dt>Крит. множитель</dt><dd>@s.CriticalMultiplier.ToString("0.##")×</dd><dt>Шанс статуса</dt><dd>@((s.StatusChance*100).ToString("0.#"))%</dd>}
</dl><details class="warnings"><summary>Что не учитывается в расчёте</summary><ul>@foreach(var warning in s.Warnings){<li>@warning</li>}</ul></details></section>
<section class="panel auto-confirm"><h2>Сохранить эту сборку?</h2><p>После подтверждения появится новый билд в твоём профиле. Его можно будет изменить вручную.</p><p class="muted small">Предпросмотр действует 15 минут. Перезапуск сервера или обновление каталога может потребовать нового подбора.</p><div class="actions">
<form action="/AutoBuild/Confirm" method="post">@Html.AntiForgeryToken()<input type="hidden" name="token" value="@Model.Token"/><button class="button primary" disabled="@(!hasMods)" data-auto-confirm>Подтвердить и сохранить</button></form>
<form action="/AutoBuild/Cancel" method="post">@Html.AntiForgeryToken()<input type="hidden" name="token" value="@Model.Token"/><button class="button" data-auto-cancel>Отменить предложение</button></form></div></section>
