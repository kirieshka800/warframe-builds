@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model ArsenalViewModel
@{ViewData["Title"]="Арсенал";}<section class="page-heading"><span class="eyebrow">БАЗА ЗНАНИЙ / СНАРЯЖЕНИЕ</span><h1>Найди свой инструмент.</h1><p>Базовые характеристики, совместимые моды и начало новой сборки.</p></section>@if(User.Identity?.IsAuthenticated==true && Configuration.GetValue("Catalog:AllowSync",true)){<details class="panel catalog-sync"><summary>Обновить данные арсенала</summary><p class="muted small">Загрузить актуальные варфреймы, оружие и моды из открытого каталога. Запрос к сети может занять около двух минут; после завершения страница обновится.</p><form method="post" action="/Home/SyncData" data-busy-form>@Html.AntiForgeryToken()<button class="button" data-busy-label="Загрузка каталога…">Обновить каталог ↓</button></form></details>}<div class="tabs"><a class="@(Model.Kind=="warframes"?"active":"")" href="?kind=warframes">Варфреймы</a><a class="@(Model.Kind=="weapons"?"active":"")" href="?kind=weapons">Оружие</a><a class="@(Model.Kind=="mods"?"active":"")" href="?kind=mods">Моды</a></div><form method="get" class="filter-bar"><input type="hidden" name="kind" value="@Model.Kind"/><input name="search" value="@Model.Search" aria-label="Поиск снаряжения" placeholder="Название снаряжения или мода…"/><button class="button">Найти →</button></form><p class="muted">Найдено: @Model.Total</p><div class="card-grid">@foreach(var x in Model.Warframes){<article class="equipment-card"><span class="card-type">WARFRAME</span><div class="equipment-glyph">@if(!string.IsNullOrWhiteSpace(x.ImageName)){<img src="https://cdn.warframestat.us/img/@x.ImageName" alt="" loading="lazy" data-equipment-image/>}else{<span>◈</span>}</div><h3>@x.Name</h3><p class="clamp">@x.Description</p><div class="mini-stats"><span>♥ @x.BaseHealth</span><span>◈ @x.BaseShield</span><span>⬡ @x.BaseArmor</span></div><a class="card-link" href="/Builds/Create?warframeId=@x.Id">Создать билд ↗</a></article>}@foreach(var x in Model.Weapons){<article class="equipment-card"><span class="card-type">@x.Category / @x.WeaponType</span><div class="equipment-glyph">@if(!string.IsNullOrWhiteSpace(x.ImageName)){<img src="https://cdn.warframestat.us/img/@x.ImageName" alt="" loading="lazy" data-equipment-image/>}else{<span>⌁</span>}</div><h3>@x.Name</h3><p class="clamp">@x.Description</p><div class="mini-stats"><span>Урон @x.BaseDamage.ToString("0.#")</span><span>Крит. @((x.CriticalChance*100).ToString("0.#"))%</span></div><a class="card-link" href="/Builds/Create?weaponId=@x.Id">Создать билд ↗</a></article>}@foreach(var x in Model.Mods){<article class="equipment-card mod-catalog"><span class="card-type">@x.Compatibility / @x.Rarity</span><div class="equipment-glyph">◇</div><h3>@x.Name</h3><p>@x.Description</p><div class="mini-stats"><span>@x.Polarity</span><span>Ранг 0–@x.MaxRank</span>@if(x.Type.Contains("Aura",StringComparison.OrdinalIgnoreCase)||x.Type.Contains("Stance",StringComparison.OrdinalIgnoreCase)){<span>Бонус вместимости @Math.Abs(x.BaseDrain) (ранг 0)</span>}else{<span>Вмест. @Math.Abs(x.BaseDrain) (ранг 0)</span>}</div></article>}</div>@if(Model.Total==0){<div class="empty"><h2>Ничего не найдено</h2><p>Попробуй другое название.</p></div>}<div class="pagination">@if(Model.Page>1){<a asp-action="Index" asp-route-search="@Model.Search" asp-route-kind="@Model.Kind" asp-route-page="@(Model.Page-1)">← Назад</a>}<span>Страница @Model.Page</span>@if(Model.Page*24<Model.Total){<a asp-action="Index" asp-route-search="@Model.Search" asp-route-kind="@Model.Kind" asp-route-page="@(Model.Page+1)">Далее →</a>}</div>