@model BuildCatalogViewModel
@{ViewData["Title"]="Билды сообщества";}<section class="page-heading heading-row"><div><span class="eyebrow">МАСТЕРСКАЯ СООБЩЕСТВА</span><h1>Сборки, которые работают.</h1><p>Варфреймы и оружие. Идеи для твоего следующего выхода.</p></div><a class="button primary" href="/Builds/Create">＋ Создать билд</a></section><form class="filter-bar" method="get"><input name="search" value="@Model.Search" placeholder="Поиск по названию или снаряжению" aria-label="Поиск билдов"/><select name="kind" aria-label="Тип"><option value="">Всё снаряжение</option><option value="warframe" selected="@(Model.Kind=="warframe")">Варфреймы</option><option value="weapon" selected="@(Model.Kind=="weapon")">Оружие</option></select><label class="check"><input type="checkbox" name="mine" value="true" checked="@Model.Mine"/> Мои билды</label><button class="button">Найти →</button></form><p class="muted">Найдено: @Model.Total</p><div class="card-grid">@foreach(var build in Model.Builds){<a class="build-card" href="/Builds/Details/@build.Id"><div class="card-top"><span class="tag">@(build.IsWeapon?"ОРУЖИЕ":"ВАРФРЕЙМ")</span><span>↗</span></div><div class="build-glyph">@(build.IsWeapon?"⌁":"◈")</div><span class="eyebrow">@build.TargetName</span><h3>@build.Title</h3><p class="clamp">@build.Description</p><div class="card-bottom"><span>@build.AuthorName</span><span>@build.FormasCount ФОРМ</span></div></a>}</div>@if(!Model.Builds.Any()){<div class="empty"><h2>Пока нет подходящих билдов</h2><p>Измени фильтры или создай первый.</p><a class="button" href="/Builds/Create">Начать сборку →</a></div>}<div class="pagination">@if(Model.Page>1){<a asp-action="Index" asp-route-search="@Model.Search" asp-route-kind="@Model.Kind" asp-route-mine="@Model.Mine" asp-route-page="@(Model.Page-1)">← Назад</a>}<span>Страница @Model.Page</span>@if(Model.Page*Model.PageSize<Model.Total){<a asp-action="Index" asp-route-search="@Model.Search" asp-route-kind="@Model.Kind" asp-route-mine="@Model.Mine" asp-route-page="@(Model.Page+1)">Далее →</a>}</div><details class="panel import"><summary>Импортировать билд из JSON</summary><form action="/Builds/Import" method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<label>Файл экспорта<input type="file" name="file" accept=".json,application/json" required/></label><button class="button">Импортировать</button></form></details>