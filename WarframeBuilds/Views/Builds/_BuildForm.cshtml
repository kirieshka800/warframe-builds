@model CreateBuildViewModel
<div asp-validation-summary="All" class="validation"></div><label>Название билда<input asp-for="Input.Title" placeholder="Например, Saryn · Стальной путь" required/></label><div class="form-grid"><label>Тип снаряжения<select asp-for="Input.TargetType" data-target-type><option value="warframe">Варфрейм</option><option value="weapon">Оружие</option></select></label><label data-target="warframe">Варфрейм<select asp-for="Input.WarframeId"><option value="">Выбери варфрейм</option>@foreach(var x in Model.Warframes){<option value="@x.Id">@x.Name</option>}</select></label><label data-target="weapon">Оружие<select asp-for="Input.WeaponId"><option value="">Выбери оружие</option>@foreach(var x in Model.Weapons){<option value="@x.Id">@x.Name (@x.Category)</option>}</select></label></div><label>Описание и тактика<textarea asp-for="Input.Description" rows="5" placeholder="Расскажи, как работает твоя сборка…"></textarea></label><div class="form-grid"><label>Количество форм<input asp-for="Input.FormasCount" type="number" min="0" max="100"/></label><label data-target="warframe">Способность Гельминта<input asp-for="Input.HelminthAbility" placeholder="Необязательно"/></label></div><label class="check"><input asp-for="Input.HasReactor"/> Реактор / катализатор Орокин (двойная вместимость)</label>