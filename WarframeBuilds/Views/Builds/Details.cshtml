@model BuildEditorViewModel
@functions {
    private static string? RankEffect(Mod mod, int rank)
    {
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(mod.LevelStatsJson);
            var root = document.RootElement;
            if (root.ValueKind != System.Text.Json.JsonValueKind.Array || rank < 0 || rank >= root.GetArrayLength()) return null;
            if (!root[rank].TryGetProperty("stats", out var stats) || stats.ValueKind != System.Text.Json.JsonValueKind.Array) return null;
            var lines = stats.EnumerateArray().Where(x => x.ValueKind == System.Text.Json.JsonValueKind.String).Select(x => System.Text.RegularExpressions.Regex.Replace(x.GetString() ?? "", "<[^>]+>", "")).ToList();
            return lines.Count > 0 ? string.Join("\n", lines) : null;
        }
        catch (System.Text.Json.JsonException) { return null; }
    }
}

@{ViewData["Title"]=Model.Build.Title;var b=Model.Build;var s=Model.Stats;}
<section class="page-heading"><div class="breadcrumbs"><a href="/Builds">Билды</a> / @b.TargetName</div><span class="eyebrow">@(b.IsWeapon?"ОРУЖИЕ":"ВАРФРЕЙМ") / @b.TargetName</span><h1>@b.Title</h1><p>@b.AuthorName · @b.FormasCount форм · @(b.HasReactor?"Установлен реактор / катализатор":"Без реактора / катализатора")</p><div class="actions"><button class="button" data-copy-url>Скопировать ссылку ↗</button><a class="button subtle" href="/Builds/Export/@b.Id">Экспорт JSON ↓</a>@if(User.Identity?.IsAuthenticated==true){<form method="post" action="/Builds/Duplicate/@b.Id">@Html.AntiForgeryToken()<button class="button">Создать копию</button></form>}@if(Model.IsOwner){<a class="button" href="/Builds/Edit/@b.Id">Настройки</a><form method="post" action="/Builds/Delete/@b.Id" data-confirm="Удалить этот билд?">@Html.AntiForgeryToken()<button class="button danger">Удалить</button></form>}</div></section>
<div class="editor-layout"><section><div class="section-title"><h2>Конфигурация модов</h2><span class="tag">@(Model.IsOwner?"РЕДАКТИРОВАНИЕ":"ПРОСМОТР")</span></div><div class="slot-grid" data-testid="mod-slots">@foreach(var index in ModCompatibility.ValidSlots(b)){var slot=b.BuildMods.FirstOrDefault(x=>x.SlotIndex==index);var mod=slot?.Mod;var slotName=index==8?(b.IsWeapon?"Стойка":"Аура"):index==9?"Эксилус":$"Слот {index+1}";<article class="slot @(mod!=null?"equipped":"")" data-testid="mod-slot-@index"><div class="slot-heading"><span>@slotName</span><span>@(slot?.SlotPolarity??"None")</span></div><div class="slot-content"><span class="mod-symbol">@(mod!=null?"◈":"＋")</span><h3>@(mod?.Name??"Свободный слот")</h3>@if(mod!=null){<p>Ранг @slot!.CurrentRank / @mod.MaxRank · @BuildCalculator.ModCost(mod,slot.CurrentRank,slot.SlotPolarity,index==8) вмест.</p>var effect=RankEffect(mod,slot.CurrentRank);<p class="mod-description preline">@(effect ?? mod.Description)</p>@if(effect==null){<p class="small">Описание из каталога; эффект выбранного ранга недоступен и не рассчитан.</p>}}</div>@if(Model.IsOwner){<details class="slot-editor"><summary>@(mod!=null?"Изменить мод":"Установить мод")</summary><form action="/Builds/AddMod" method="post" class="mod-picker">@Html.AntiForgeryToken()<input type="hidden" name="buildId" value="@b.Id"/><input type="hidden" name="slotIndex" value="@index"/><label>Поиск мода<input type="search" data-mod-search placeholder="Название мода…"/></label><label>Мод<select name="modId" data-mod-select><option value="0" data-max-rank="0">— Удалить / пусто —</option>@foreach(var m in Model.Mods.Where(m=>ModCompatibility.CanEquip(b,m,index))){<option value="@m.Id" data-max-rank="@m.MaxRank" selected="@(mod?.Id==m.Id)">@m.Name · @m.Polarity · @m.BaseDrain</option>}</select></label><label>Ранг<select name="currentRank" data-rank data-current="@(slot?.CurrentRank??0)">@for(var r=0;r<=(mod?.MaxRank??0);r++){<option value="@r" selected="@(slot?.CurrentRank==r)">@r</option>}</select></label><button class="button primary">Применить</button></form><form action="/Builds/SetSlotPolarity" method="post">@Html.AntiForgeryToken()<input type="hidden" name="buildId" value="@b.Id"/><input type="hidden" name="slotIndex" value="@index"/><label>Полярность<select name="polarity">@foreach(var pol in ModCompatibility.Polarities.Where(p=>p!="Universal" || index==8)){<option selected="@((slot?.SlotPolarity??"None")==pol)">@pol</option>}</select></label><button class="button">Сохранить полярность</button></form></details>}</article>}</div><section class="panel description"><h2>Тактика и примечания</h2><p class="preline">@(string.IsNullOrWhiteSpace(b.Description)?"Автор пока не добавил описание.":b.Description)</p>@if(!string.IsNullOrWhiteSpace(b.HelminthAbility)){<p>Гельминт: <strong>@b.HelminthAbility</strong></p>}</section></section><aside class="stats-panel panel" data-testid="build-statistics"><span class="eyebrow">ПАРАМЕТРЫ СБОРКИ</span><h2>Характеристики</h2><div class="capacity"><span>Вместимость</span><strong class="@(s.UsedCapacity>s.Capacity?"over-capacity":"")">@s.UsedCapacity <small>/ @s.Capacity</small></strong></div><progress max="@s.Capacity" value="@Math.Min(s.UsedCapacity,s.Capacity)" aria-label="Использованная вместимость"></progress><dl class="stat-list">@if(!b.IsWeapon){<dt>Здоровье</dt><dd>@s.Health.ToString("0.#")</dd><dt>Щиты</dt><dd>@s.Shields.ToString("0.#")</dd><dt>Броня</dt><dd>@s.Armor.ToString("0.#")</dd><dt>Энергия</dt><dd>@s.Energy.ToString("0.#")</dd><dt>Сила</dt><dd>@s.AbilityStrength.ToString("0.#")%</dd><dt>Длительность</dt><dd>@s.AbilityDuration.ToString("0.#")%</dd><dt>Радиус</dt><dd>@s.AbilityRange.ToString("0.#")%</dd><dt>Эффективность</dt><dd>@s.AbilityEfficiency.ToString("0.#")%</dd>}else{<dt>Урон за попадание</dt><dd>@s.Damage.ToString("0.##")</dd><dt>Критический шанс</dt><dd>@((s.CriticalChance*100).ToString("0.#"))%</dd><dt>Крит. множитель</dt><dd>@s.CriticalMultiplier.ToString("0.##")×</dd><dt>Шанс статуса</dt><dd>@((s.StatusChance*100).ToString("0.#"))%</dd><dt>Темп / скорость</dt><dd>@s.FireRate.ToString("0.##")</dd><dt>Мультивыстрел</dt><dd>@s.Multishot.ToString("0.##")</dd><dt>Магазин</dt><dd>@s.MagazineSize</dd><dt>Перезарядка</dt><dd>@s.ReloadTime.ToString("0.##") с</dd>}</dl><p class="muted small">Базовые показатели без временных усилений. Проверяй взаимодействия в игре.</p>@if(s.Warnings.Any()){<details class="warnings"><summary>Примечания расчёта (@s.Warnings.Count)</summary><ul>@foreach(var warning in s.Warnings){<li>@warning</li>}</ul></details>}</aside></div>
<section class="panel comments" id="comments" data-testid="build-comments"><div class="section-title"><h2>Обсуждение</h2><span class="tag">@Model.Comments.Count</span></div>
@if(Model.Comments.Any()) { foreach(var comment in Model.Comments.OrderByDescending(x=>x.CreatedAt)) {<article class="comment"><div class="comment-meta"><strong>@comment.AuthorName</strong><time datetime="@comment.CreatedAt.ToString("O")">@comment.CreatedAt.ToString("dd.MM.yyyy HH:mm") UTC</time></div><p class="preline">@comment.Text</p></article>} } else {<p class="muted">Обсуждение ещё не началось. Поделись идеей или задай вопрос автору.</p>}
@if(User.Identity?.IsAuthenticated==true){<form method="post" action="/Builds/AddComment" data-testid="comment-form">@Html.AntiForgeryToken()<input type="hidden" name="buildId" value="@b.Id"/><label for="comment-text">Твой комментарий</label><textarea id="comment-text" name="text" maxlength="2000" required rows="4" aria-describedby="comment-help" placeholder="Расскажи о своём опыте со сборкой…"></textarea><p id="comment-help" class="muted small">До 2000 символов. Уважай других Тэнно.</p><button class="button primary">Отправить комментарий</button></form>}else{<p><a class="button" href="/auth/profile">Войти и присоединиться к обсуждению →</a></p>}
</section>
