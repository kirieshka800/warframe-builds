@model List<Warframe>
@{ViewData["Title"]="Твоя следующая эволюция";}
<section class="hero"><div class="hero-copy"><span class="eyebrow"><i></i> ИНСТРУМЕНТЫ ДЛЯ ТЭННО</span><h1>Сила —<br/>в <em>твоей сборке.</em></h1><p>Преврати любимое снаряжение в идеальный инструмент. Создавай билды варфреймов и оружия, экспериментируй с модами и делись результатом.</p><div class="actions"><a class="button primary" href="/AutoBuild">Подобрать билд <span>↗</span></a><a class="button" href="/Builds">Исследовать билды →</a></div><div class="hero-note">01 / СОБИРАЙ БЕЗ ОГРАНИЧЕНИЙ</div></div><div class="hero-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="void-symbol">◈</div><div class="art-label">ORIGIN SYSTEM<br/><strong>BUILD YOUR LEGACY</strong></div><span class="coord">VOID SIGNAL / 07.04</span></div></section>
<div class="metrics"><div><strong>@ViewBag.FrameCount</strong><span>Варфреймов</span></div><div><strong>@ViewBag.WeaponCount</strong><span>Оружия</span></div><div><strong>@ViewBag.ModCount</strong><span>Модов</span></div><div><strong>@ViewBag.BuildCount</strong><span>Билдов сообщества</span></div></div>
<section class="section"><div class="section-title"><div><span class="eyebrow">ТВОЙ АРСЕНАЛ</span><h2>Выбери свою силу</h2></div><a href="/Database">Весь арсенал ↗</a></div><div class="card-grid">@foreach(var frame in Model.Take(8)){<a class="equipment-card" href="/Builds/Create?warframeId=@frame.Id"><span class="card-type">WARFRAME</span><div class="equipment-glyph">@if(!string.IsNullOrWhiteSpace(frame.ImageName)){<img src="https://cdn.warframestat.us/img/@frame.ImageName" alt="" loading="lazy" data-equipment-image/>}else{<span>◈</span>}</div><h3>@frame.Name</h3><span class="card-link">Создать билд ↗</span></a>}</div></section><section class="callout"><div><span class="eyebrow">ЗНАНИЯ — ТВОЁ ОРУЖИЕ</span><h2>Каждый мод имеет значение.</h2><p>Разберись с полярностями, вместимостью и синергиями в гайдах сообщества.</p></div><a class="button" href="/Guides">Читать гайды →</a></section>