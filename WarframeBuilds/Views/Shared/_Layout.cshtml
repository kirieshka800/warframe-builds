@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!DOCTYPE html>
<html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · TENNO LAB</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head>
<body><a class="skip" href="#main">К содержимому</a><header class="site-header"><a class="brand" href="/"><span class="brand-mark">◈</span> TENNO<span>LAB</span></a><nav aria-label="Основная навигация"><a href="/Builds">Билды</a><a href="/Builds/Create">Конструктор</a><a href="/Database">Арсенал</a><a href="/Guides">Гайды</a></nav><div class="account">@if(User.Identity?.IsAuthenticated == true){<span>@User.Identity.Name</span><form action="/auth/logout" method="post">@Html.AntiForgeryToken()<button class="button subtle">Выйти</button></form>}else{<a class="button subtle" href="@(Configuration.GetValue("Authentication:AllowLocalProfiles", true) ? "/auth/profile" : "/auth/login")">Войти</a>}</div></header><main id="main" class="container">@if(TempData["Success"] is string success){<div class="notice">@success</div>}@if(TempData["Error"] is string error){<div class="notice error" role="alert">@error</div>}@RenderBody()</main><footer><a class="brand" href="/">◈ TENNO LAB</a><span>Создавай. Улучшай. Покоряй Изначальную систему.</span><small>Неофициальный проект сообщества. Warframe © Digital Extremes.</small></footer><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>