  <diagram id="02-state-0" name="Предложение автоподбора">
    <mxGraphModel dx="1500" dy="1390" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1390" math="0" shadow="0">
      <root>
        <mxCell id="0" />
