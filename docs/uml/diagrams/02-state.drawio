        <mxCell id="edge4" value="GET, Confirm или Cancel [владелец; запись доступна] /&lt;br&gt;открыть Details(SavedBuildId); не создавать копию" style="edgeStyle=segmentEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=13;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;" edge="1" parent="1" source="saved" target="saved">
