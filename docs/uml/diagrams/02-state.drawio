        <mxCell id="title" value="ЛР15 · Состояния предложения автоподбора" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeWidth=1.6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#0f172a;fontStyle=1;fontSize=26;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="22" width="1420" height="44" />
        </mxCell>
        <mxCell id="subtitle" value="Объект: AutoBuildProposalStore.Proposal · состояние определяется Cancelled, SavedBuildId и доступностью в MemoryCache" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeWidth=1.6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#475569;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="72" width="1420" height="40" />
        </mxCell>
        <mxCell id="start" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeWidth=1.6;ellipse;aspect=fixed;fillColor=#172033;strokeColor=#172033;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="735" y="150" width="28" height="28" />
        </mxCell>
        <mxCell id="pending" value="Ожидает подтверждения&lt;br&gt;&lt;br&gt;Cancelled = false&lt;br&gt;SavedBuildId = null&lt;br&gt;entry / сохранить OwnerId, Plan, Fingerprint, ExpiresAt" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeWidth=1.6;rounded=1;arcSize=14;fillColor=#eef4ff;strokeColor=#607ba8;fontSize=15;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="265" width="500" height="190" />
        </mxCell>
        <mxCell id="saved" value="Сохранено&lt;br&gt;&lt;br&gt;SavedBuildId = id&lt;br&gt;entry / Build уже записан в PostgreSQL&lt;br&gt;Билд существует независимо от кэша" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeWidth=1.6;rounded=1;arcSize=14;fillColor=#eef4ff;strokeColor=#607ba8;fontSize=15;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="700" width="500" height="190" />
        </mxCell>
        <mxCell id="cancelled" value="Отменено&lt;br&gt;&lt;br&gt;Cancelled = true&lt;br&gt;SavedBuildId = null&lt;br&gt;entry / показать сообщение об отмене" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeWidth=1.6;rounded=1;arcSize=14;fillColor=#eef4ff;strokeColor=#607ba8;fontSize=15;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="920" y="700" width="500" height="190" />
        </mxCell>
        <mxCell id="end" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeWidth=1.6;shape=doubleEllipse;fillColor=#172033;strokeColor=#172033;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="735" y="1160" width="30" height="30" />
        </mxCell>
        <mxCell id="note" value="Это аналитические состояния, а не enum в коде. Конечная точка завершает жизнь предложения, не удаляет Build.&lt;br&gt;Запрос чужого владельца получает 404 без изменения состояния. Неизвестный или истёкший токен ведёт на форму подбора.&lt;br&gt;При изменении каталога Confirm не устанавливает Cancelled и не удаляет предложение: нужен новый подбор." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeWidth=1.6;shape=note;size=15;fillColor=#fffbe8;strokeColor=#bca45d;align=left;spacing=12;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1240" width="1380" height="110" />
        </mxCell>
        <mxCell id="edge0" value="Add(owner, plan, fingerprint) / создать запись" style="edgeStyle=segmentEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;" edge="1" parent="1" source="start" target="pending">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="749.0" y="221.5" />
              <mxPoint x="750.0" y="221.5" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge1" value="Confirm [владелец; TTL не истёк; есть моды;&lt;br&gt;каталог и вместимость проверены] /&lt;br&gt;commit Build; SavedBuildId = id" style="edgeStyle=segmentEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=13;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;" edge="1" parent="1" source="pending" target="saved">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="330" y="360" />
            </Array>
          </mxGeometry>
        </mxCell>
