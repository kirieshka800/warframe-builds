        <mxCell id="keys" value="«развёртывание» Ключи защиты&lt;br&gt;&lt;br&gt;App_Data/Keys&lt;br&gt;Том app-keys&lt;br&gt;Data Protection для cookies" style="shape=module;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#eef4ff;strokeColor=#607ba8;strokeWidth=1.6;spacingLeft=24;spacingRight=14;" vertex="1" parent="1">
